# LLM judges (OpenRouter) and Jev (TypeSafe). None of these is needed to run
# the open-weight detectors or to rebuild the numbers with `hallubench reproduce`.
OPENROUTER_API_KEY=
TYPESAFE_KEY=
# AWS Bedrock contextual grounding check: an IAM user with Bedrock access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Google Check Grounding API: project id here, service-account key in gcp-key.json
GCP_PROJECT=
